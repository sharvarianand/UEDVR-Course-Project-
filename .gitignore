# Unity .gitignore Template
# Extended for multi-folder Unity projects & SIH 2026

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Unity cache and generated files (matches root and nested projects)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
*BurstDebugInformation_DoNotShip*/
*BurstDebugInformation_DoNotShip*
*.log

# Blender backup files
*.blend1
*.blend1.meta

# JetBrains / Rider / Visual Studio Code / IDE
.idea/
.vs/
.vscode/
*.DotSettings.user
.consulo/
ExportedObj/
.gradle/

# Project & Solution files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for debug/temp
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*

# Builds & Binaries
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app/
*.ipa
*.exe
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores
ServerData/
StreamingAssets/aa*
AddressableAssetsData/link.xml*
Addressables_Temp*
AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Scene Dependency Cache
SceneDependencyCache*

# Web & Node ignores
node_modules/
dist/
dist-ssr/
.vercel/
*.local

# Build & signing artifacts
*.idsig
*.apk.idsig

# UI Toolkit auto-generated schema
UIElementsSchema/


